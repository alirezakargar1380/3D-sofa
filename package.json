{
  "name": "@minimal-kit/next-ts-modernized",
  "author": "Minimals",
  "version": "9.0.0",
  "description": "Modernized Next.js, React, TypeScript, and MUI Minimal template",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev -p 8082",
    "build": "next build",
    "start": "next start -p 8082",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run audit:static && npm run typecheck && npm run lint",
    "validate": "npm run check && npm run build",
    "clean": "node -e \"for (const p of ['node_modules','.next','out','dist','build','coverage']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "audit:static": "node scripts/static-audit.mjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "2.22.1",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "18.0.1",
    "@hookform/resolvers": "5.7.1",
    "@iconify/react": "6.0.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/lab": "9.0.0-beta.6",
    "@mui/material-nextjs": "^9.1.1",
    "@mui/x-data-grid": "9.10.1",
    "@mui/x-date-pickers": "9.10.1",
    "@react-pdf/renderer": "4.5.1",
    "apexcharts": "6.7.0",
    "autosuggest-highlight": "3.3.4",
    "aws-amplify": "6.20.0",
    "axios": "1.19.0",
    "date-fns": "4.4.0",
    "firebase": "12.17.0",
    "framer-motion": "12.43.0",
    "highlight.js": "11.11.1",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "lodash": "4.18.1",
    "mapbox-gl": "3.27.0",
    "mui-one-time-password-input": "7.0.0",
    "next": "16.2.12",
    "notistack": "3.0.2",
    "nprogress": "0.2.0",
    "numeral": "2.0.6",
    "react": "19.2.8",
    "react-apexcharts": "2.1.1",
    "react-dom": "19.2.8",
    "react-dropzone": "20.0.0",
    "react-hook-form": "7.84.0",
    "react-i18next": "17.0.11",
    "react-map-gl": "8.1.2",
    "react-markdown": "10.1.0",
    "react-quill-new": "3.8.3",
    "react-slick": "0.31.0",
    "rehype-highlight": "7.0.2",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "simplebar-react": "3.3.2",
    "slick-carousel": "1.8.1",
    "stylis": "4.4.0",
    "stylis-plugin-rtl": "2.1.1",
    "swr": "2.4.2",
    "yet-another-react-lightbox": "3.32.2",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@types/autosuggest-highlight": "3.2.3",
    "@types/lodash": "4.17.25",
    "@types/node": "24.x",
    "@types/nprogress": "0.2.3",
    "@types/numeral": "2.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-slick": "0.23.13",
    "@types/stylis": "4.2.7",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "browser-tabs-lock@1.3.0": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true,
    "@firebase/util@1.15.2": true,
    "unrs-resolver@1.12.2": true
  }
}
